        "distance": "7",
        "persistent": "false",
        "waterlogged": "false"
      }
    }
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "trunk_placer": {
    "type": "minecraft:fancy_trunk_placer",
    "base_height": 9,
    "height_rand_a": 8,
    "height_rand_b": 0
  },
  "trunk_provider": {
