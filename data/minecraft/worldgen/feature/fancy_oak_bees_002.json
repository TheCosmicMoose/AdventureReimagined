{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "type": "minecraft:simple",
          "state": {
            "id": "minecraft:dirt"
          }
        }
      }
    ]
  },
  "root_placer": {
    "type": "minecraft:mangrove_root_placer",
