      "type": "minecraft:simple",
      "state": {
        "id": "minecraft:oak_wood",
        "properties": {
          "axis": "y"
        }
      }
    },
    "trunk_offset_y": 0,
    "mangrove_root_placement": {
      "max_root_width": 2,
      "max_root_length": 3,
      "random_skew_chance": 0.25,
      "can_grow_through": "#minecraft:dirt",
      "muddy_roots_in": "#minecraft:dirt",
