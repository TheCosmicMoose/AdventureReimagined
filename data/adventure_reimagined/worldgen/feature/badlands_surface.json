{
  "type": "minecraft:vegetation_patch",
  "surface": "floor",
  "depth": 6,
  "vertical_range": 7,
  "extra_bottom_block_chance": 0,
  "extra_edge_column_chance": 0.3,
  "vegetation_chance": 0,
  "xz_radius": {
    "type": "minecraft:uniform",
    "min_inclusive": 4,
    "max_inclusive": 6
  },
  "replaceable": [
    "minecraft:red_sand",
    "minecraft:red_sandstone"
  ],
  "ground_state": {
    "type": "minecraft:rule_based",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:matching_blocks",
          "blocks": "minecraft:red_sand"
        },
        "then": {
          "type": "minecraft:simple",
          "state": "minecraft:sand"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_blocks",
          "blocks": "minecraft:red_sandstone"
        },
        "then": {
          "type": "minecraft:simple",
          "state": "minecraft:sandstone"
        }
      }
    ]
  },
  "vegetation_feature": "adventure_reimagined:grass"
}
