{
  "type": "minecraft:vegetation_patch",
  "surface": "floor",
  "depth": 5,
  "vertical_range": 7,
  "extra_bottom_block_chance": 0,
  "extra_edge_column_chance": 0.3,
  "vegetation_chance": 0,
  "xz_radius": {
    "type": "minecraft:uniform",
    "min_inclusive": 4,
    "max_inclusive": 6
  },
  "replaceable": "#minecraft:terracotta",
  "ground_state": {
    "type": "minecraft:rule_based",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:matching_blocks",
          "blocks": "minecraft:brown_terracotta"
        },
        "then": {
          "type": "minecraft:simple",
          "state": "minecraft:terracotta"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_blocks",
          "blocks": "minecraft:terracotta"
        },
        "then": {
          "type": "minecraft:simple",
          "state": "minecraft:light_gray_terracotta"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_blocks",
          "blocks": [
            "minecraft:orange_terracotta",
            "minecraft:yellow_terracotta"
          ]
        },
        "then": {
          "type": "minecraft:simple",
          "state": "minecraft:white_terracotta"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_blocks",
          "blocks": "minecraft:red_terracotta"
        },
        "then": {
          "type": "minecraft:simple",
          "state": "minecraft:pink_terracotta"
        }
      }
    ]
  },
  "vegetation_feature": {
    "feature": "adventure_reimagined:grass_badlands",
    "placement": []
  }
}
